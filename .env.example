# ===========================================
# BeatVision Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Database - PostgreSQL for production
DATABASE_URL="postgresql://user:password@localhost:5432/beatvision"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Storage - Cloudflare R2 or AWS S3
STORAGE_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="beatvision"
STORAGE_PUBLIC_URL="https://pub-YOUR_BUCKET_ID.r2.dev"

# Stripe - Payment Processing
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_CREATOR_MONTHLY_PRICE_ID="price_..."
STRIPE_CREATOR_YEARLY_PRICE_ID="price_..."
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
STRIPE_PRO_YEARLY_PRICE_ID="price_..."
STRIPE_TEAM_MONTHLY_PRICE_ID="price_..."
STRIPE_TEAM_YEARLY_PRICE_ID="price_..."

# Redis (optional - for job queues)
REDIS_URL="redis://localhost:6379"

# AI Features (optional)
OPENAI_API_KEY=""

# Email (optional)
RESEND_API_KEY=""
