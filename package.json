{
  "name": "beatvision",
  "version": "0.1.0",
  "private": true,
  "description": "Advanced Real-Time Music Visualizer",
  "scripts": {
    "dev": "pnpm --filter @beatvision/web dev",
    "build": "pnpm --filter @beatvision/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "engines": {
    "node": ">=18"
  }
}
